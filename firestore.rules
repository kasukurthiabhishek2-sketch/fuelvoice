/**
 * FuelVoice Firestore Security Rules
 *
 * Authority is stored in Firestore and can only be granted by an existing
 * administrator or a trusted server/console operation. Client-provided email
 * addresses and NEXT_PUBLIC_* values are never authorization sources.
 */

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isNotBanned() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned == false;
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn() && request.auth.uid == userId &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.role == 'user' &&
        request.resource.data.isBanned == false &&
        request.resource.data.reviewCount == 0 &&
        request.resource.data.likeCount == 0;

      allow update: if signedIn() && request.auth.uid == userId &&
        changedOnly(['displayName', 'photoURL']);

      allow update: if signedIn() && request.auth.uid == userId && isNotBanned() &&
        changedOnly(['reviewCount', 'lastReviewAt']) &&
        request.resource.data.reviewCount == resource.data.reviewCount + 1 &&
        request.resource.data.lastReviewAt == request.time;

      allow update: if isAdmin();
      allow delete: if false;
    }

    match /stations/{stationId} {
      allow read: if true;

      allow create: if signedIn() && isNotBanned() &&
        stationId.matches('^(node|way|relation)_[0-9]+$') &&
        request.resource.data.id == stationId &&
        request.resource.data.lat is number &&
        request.resource.data.lng is number &&
        request.resource.data.lat >= -90 && request.resource.data.lat <= 90 &&
        request.resource.data.lng >= -180 && request.resource.data.lng <= 180 &&
        request.resource.data.avgRating == 0 &&
        request.resource.data.reviewCount == 0 &&
        request.resource.data.complaintCount == 0;

      allow update: if isAdmin() || (
        signedIn() && isNotBanned() &&
        existsAfter(/databases/$(database)/documents/reviews/$(stationId + '__' + request.auth.uid)) &&
        changedOnly(['reviewCount', 'complaintCount', 'lastUpdated', 'avgRating', 'scores'])
      );

      allow delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.isHidden == false || isAdmin();

      allow create: if signedIn() && isNotBanned() &&
        request.resource.data.stationId is string &&
        reviewId == request.resource.data.stationId + '__' + request.auth.uid &&
        !request.resource.data.keys().hasAny(['userId']) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 3 &&
        request.resource.data.title.size() <= 100 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() >= 10 &&
        request.resource.data.content.size() <= 2000 &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.likeCount == 0 &&
        request.resource.data.reportCount == 0 &&
        request.resource.data.isHidden == false &&
        request.resource.data.isFeatured == false &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update: if signedIn() && changedOnly(['likeCount']) && (
        (!exists(/databases/$(database)/documents/likes/$(reviewId + '__' + request.auth.uid)) &&
          existsAfter(/databases/$(database)/documents/likes/$(reviewId + '__' + request.auth.uid)) &&
          request.resource.data.likeCount == resource.data.likeCount + 1) ||
        (exists(/databases/$(database)/documents/likes/$(reviewId + '__' + request.auth.uid)) &&
          !existsAfter(/databases/$(database)/documents/likes/$(reviewId + '__' + request.auth.uid)) &&
          request.resource.data.likeCount == resource.data.likeCount - 1)
      );

      allow update: if signedIn() && changedOnly(['reportCount']) &&
        !exists(/databases/$(database)/documents/reports/$(reviewId + '__' + request.auth.uid)) &&
        existsAfter(/databases/$(database)/documents/reports/$(reviewId + '__' + request.auth.uid)) &&
        request.resource.data.reportCount == resource.data.reportCount + 1;

      allow update, delete: if isAdmin();
    }

    match /likes/{likeId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if signedIn() && isNotBanned() &&
        likeId == request.resource.data.reviewId + '__' + request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.keys().hasOnly(['reviewId', 'userId', 'createdAt']);

      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /reports/{reportId} {
      allow read: if signedIn() && (resource.data.reporterId == request.auth.uid || isAdmin());

      allow create: if signedIn() && isNotBanned() &&
        reportId == request.resource.data.reviewId + '__' + request.auth.uid &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.reviewedAt == null &&
        request.resource.data.reviewedBy == null &&
        request.resource.data.reason in ['spam', 'abuse', 'misinformation', 'harassment', 'other'];

      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
